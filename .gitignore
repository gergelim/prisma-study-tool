# Dependências
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Banco de dados local SQLite (gerado automaticamente na primeira execução)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite

# Imagens baixadas via scraper (baixadas sob demanda na importação)
public/images/*
!public/images/.gitkeep

# Binários e instaladores
*.apk
*.aab

# Variáveis de ambiente e segredos locais
.env
.env.local

# Logs e arquivos temporários do sistema
logs/
*.log
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
